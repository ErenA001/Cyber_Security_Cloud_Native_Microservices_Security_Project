# NVIDIA NIM (OpenAI-compatible chat completions API)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_TIMEOUT_SECONDS=45
ACCESS_TOKEN_MINUTES=60

# These are generated automatically by: python3 scripts/setup.py
JWT_SECRET_KEY=GENERATE_WITH_SETUP_SCRIPT
SERVICE_TOKEN=GENERATE_WITH_SETUP_SCRIPT
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=GENERATE_WITH_SETUP_SCRIPT

# Local HTTP uses false. Set true when running behind HTTPS in production.
COOKIE_SECURE=false
