FROM python:3.12-slim
WORKDIR /workspace
COPY services/auth/requirements.txt /tmp/auth-requirements.txt
COPY services/ai/requirements.txt /tmp/ai-requirements.txt
COPY services/monitor/requirements.txt /tmp/monitor-requirements.txt
RUN pip install --no-cache-dir -r /tmp/auth-requirements.txt -r /tmp/ai-requirements.txt -r /tmp/monitor-requirements.txt
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py", "-v"]
